# Copy this file to ".env" in the project root, then paste your values from:
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp (optional): override who receives the pre-filled message after feedback submit.
# Built-in default: https://wa.me/918855025560 — only set these if you need a different number.
# VITE_FEEDBACK_WHATSAPP_NUMBER=919876543210
# VITE_FEEDBACK_WHATSAPP_LINK=https://wa.me/919876543210

# EmailJS (feedback form — https://www.emailjs.com/)
# Copy Service ID, Template ID, and Public Key from the same account (Integration / Email Templates / Account).
# In the email template body, use {{{details_html}}} for line breaks in Gmail (HTML), or <pre style="white-space:pre-wrap;font:inherit">{{details_plain}}</pre> for plain text.
# If the Template ID does not exist for that Public Key, sends fail with HTTP 400 in the browser console.
# VITE_EMAILJS_SERVICE_ID=your_service_id
# VITE_EMAILJS_TEMPLATE_ID=your_template_id
# VITE_EMAILJS_PUBLIC_KEY=your_public_key

# After changing .env, restart the Vite dev server (npm run dev).
#
# Production (e.g. Vercel): add the same VITE_* names in the project Environment Variables
# and trigger a new deploy so the client bundle includes them (Vite bakes them at build time).
