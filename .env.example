# Copy this file to ".env" in the project root, then paste your values from:
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# WhatsApp (optional): override who receives the pre-filled message after feedback submit.
# Built-in default: https://wa.me/918855025560 — only set these if you need a different number.
# VITE_FEEDBACK_WHATSAPP_NUMBER=919876543210
# VITE_FEEDBACK_WHATSAPP_LINK=https://wa.me/919876543210

# After changing .env, restart the Vite dev server (npm run dev).
#
# Production (e.g. Vercel): add the same VITE_* names in the project Environment Variables
# and trigger a new deploy so the client bundle includes them (Vite bakes them at build time).
